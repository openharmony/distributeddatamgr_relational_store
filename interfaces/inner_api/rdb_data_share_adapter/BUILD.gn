import("//build/ohos.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store.gni")
import(
    "//foundation/distributeddatamgr/relational_store/relational_store_deps.gni")

config("rdb_data_share_adapter_config") {
  visibility = [ ":*" ]

  cflags = [
    "-Wno-c99-designator",
    "-Werror=vla",
  ]
  if (!is_mingw && !is_mac) {
    cflags_cc = [
      "-fvisibility=hidden",
      "-fno-unwind-tables",
      "-fno-asynchronous-unwind-tables",
    ]
  }
  include_dirs = [
    "include",
    "${relational_store_common_path}/include",
    "${relational_store_innerapi_path}/rdb/include",
    "${relational_store_native_path}/rdb_data_share_adapter/include",
    "${relational_store_native_path}/rdb/include",
  ]
}

config("rdb_data_share_adapter_public_config") {
  visibility = [ ":*" ]
  include_dirs = [ "include" ]
}

ohos_shared_library("rdb_data_share_adapter") {
  branch_protector_ret = "pac_ret"
  branch_protector_frt = "bti"
  sanitize = {
    boundary_sanitize = true
    ubsan = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  configs = [ ":rdb_data_share_adapter_config" ]

  ldflags = [ "-Wl,--exclude-libs,ALL" ]
  version_script = "rdb_data_share_adapter.versionscript"

  subsystem_name = "distributeddatamgr"
  part_name = "relational_store"

  deps = [ "${relational_store_innerapi_path}/rdb:native_rdb" ]
  deps += deps_hilog

  external_deps = [
    "c_utils:utils",
    "json:nlohmann_json_static",
    "kv_store:datamgr_common",
  ]
  external_deps += external_deps_hilog
  external_deps += external_deps_bounds_checking_function

  public_configs = [ ":rdb_data_share_adapter_public_config" ]

  innerapi_tags = [ "platformsdk" ]
  sources = []
  if (relational_store_data_share_enabled) {
    sources += [
      "${relational_store_native_path}/rdb_data_share_adapter/src/rdb_result_set_bridge.cpp",
      "${relational_store_native_path}/rdb_data_share_adapter/src/rdb_utils.cpp",
    ]
    external_deps += [ "data_share:datashare_common_lite" ]
  }
}
