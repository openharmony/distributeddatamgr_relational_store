import("//build/ohos.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store.gni")
import(
    "//foundation/distributeddatamgr/relational_store/relational_store_deps.gni")

config("appdatafwk_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "include",
    "${relational_store_innerapi_path}/rdb/include",
    "${relational_store_common_path}/include",
  ]
  # Linux host only: put the in-repo linux/ashmem.h shim on the include path so
  # that <ashmem.h> from c_utils (which unconditionally includes <linux/ashmem.h>,
  # unavailable on the host kernel) can be compiled. Device builds keep resolving
  # <linux/ashmem.h> to the real kernel header because this dir is absent then.
  if (is_linux) {
    include_dirs += [ "${relational_store_mock_path}/external_inner_kit/c_utils/host_include" ]
  }
  if (!is_mingw && !is_mac) {
    cflags_cc = [ "-fvisibility=hidden" ]
  }
}

config("appdatafwk_public_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "include",
    "${relational_store_innerapi_path}/rdb/include",
    "${relational_store_common_path}/include",
  ]
  if (is_linux) {
    include_dirs += [ "${relational_store_common_path}/host_include" ]
  }
}

config("common_public_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "include",
    "${relational_store_common_path}/include",
  ]
}

if (is_android || is_ios) {
  ohos_source_set("relational_common_base") {
    sources =
        [ "${relational_store_native_path}/appdatafwk/src/serializable.cpp" ]

    if (is_mingw || is_mac || is_ios) {
      sources +=
          [ "${relational_store_native_path}/appdatafwk/src/mingw_endian.cpp" ]
    } else if (is_ohos || is_android) {
      sources += [
        "${relational_store_native_path}/appdatafwk/src/general_endian.cpp",
      ]
      cflags_cc = [
        "-fvisibility=hidden",
        "-fno-unwind-tables",
        "-fno-asynchronous-unwind-tables",
        "-Werror=vla",
      ]
    }

    configs = [
      ":common_public_config",
      ":appdatafwk_public_config",
    ]

    deps = [
      "//base/hiviewdfx/hilog/interfaces/native/innerkits:libhilog_${target_os}",
      "//third_party/json:nlohmann_json_static",
    ]

    subsystem_name = "distributeddatamgr"
    part_name = "relational_store"

    public_configs = [ ":common_public_config" ]
  }
} else {
  ohos_shared_library("relational_common_base") {
    if (is_ohos) {
      branch_protector_ret = "pac_ret"
      branch_protector_frt = "bti"
      sanitize = {
        boundary_sanitize = true
        ubsan = true
        cfi = true
        cfi_cross_dso = true
        debug = false
      }
    }

    sources =
        [ "${relational_store_native_path}/appdatafwk/src/serializable.cpp" ]

    if (is_mingw || is_mac || is_ios) {
      sources +=
          [ "${relational_store_native_path}/appdatafwk/src/mingw_endian.cpp" ]
    } else if (is_ohos || is_android || is_linux) {
      sources += [
        "${relational_store_native_path}/appdatafwk/src/general_endian.cpp",
      ]
      cflags_cc = [
        "-fvisibility=hidden",
        "-fno-unwind-tables",
        "-fno-asynchronous-unwind-tables",
        "-Werror=vla",
      ]
    }

    configs = [
      ":common_public_config",
      ":appdatafwk_public_config",
    ]
    if (is_ohos) {
      ldflags = [ "-Wl,--exclude-libs,ALL" ]
    }
    deps = []
    deps += deps_hilog

    external_deps = [
      "json:nlohmann_json_static",
    ]
    external_deps += external_deps_hilog

    subsystem_name = "distributeddatamgr"
    part_name = "relational_store"

    public_configs = [ ":common_public_config" ]
  }
}

ohos_shared_library("native_appdatafwk") {
  if (is_ohos) {
    branch_protector_ret = "pac_ret"
    branch_protector_frt = "bti"
    sanitize = {
      boundary_sanitize = true
      ubsan = true
      cfi = true
      cfi_cross_dso = true
      debug = false
    }
  }

  sources =
      [ "${relational_store_native_path}/appdatafwk/src/shared_block.cpp" ]
  # Linux host only: upstream c_utils excludes ashmem.cpp from its host build
  # (and unconditionally requires <linux/ashmem.h> in the header), so the Ashmem
  # symbols are absent on host. Vendor the implementation here under host only;
  # device builds still get Ashmem from c_utils, avoiding duplicate definitions.
  if (is_linux) {
    sources += [ "${relational_store_mock_path}/external_inner_kit/c_utils/ashmem.cpp" ]
  }

  configs = [ ":appdatafwk_config" ]

  ldflags = [ "-Wl,--exclude-libs,ALL" ]
  version_script = "native_appdatafwk.versionscript"

  subsystem_name = "distributeddatamgr"
  innerapi_tags = [ "platformsdk_indirect" ]
  part_name = "relational_store"

  deps = []
  deps += deps_hilog
  deps += deps_ipc_single

  external_deps = [
    "c_utils:utils",
    "json:nlohmann_json_static",
  ]
  external_deps += external_deps_hilog
  external_deps += external_deps_ipc_single
  external_deps += external_deps_bounds_checking_function

  public_configs = [ ":appdatafwk_public_config" ]
}
