import("//build/ohos.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store.gni")
import("platform/common.gni")

if (!is_ohos && !is_android && !is_ios) {
  base_sources += [ "${relational_store_mock_path}/frameworks/native/rdb/mock.cpp",
                    "${relational_store_mock_path}/frameworks/native/rdb/shared_block_mock.cpp",
  ]
} else if (is_android || is_ios) {
  base_sources += [ "${relational_store_mock_path}/frameworks/native/rdb/shared_block_mock.cpp" ]
}
if (is_ohos) {
  import("platform/ohos/config.gni")
} else if (is_mingw) {
  import("platform/mingw/config.gni")
} else if (is_mac) {
  import("platform/mac/config.gni")
} else if (is_android) {
  import("platform/android/config.gni")
} else if (is_ios) {
  import("platform/ios/config.gni")
} else if (is_linux) {
  import("platform/linux/config.gni")
}

if (native_rdb_platform_add_mock_source) {
  base_sources +=
      [ "${relational_store_mock_path}/frameworks/native/rdb/mock.cpp" ]
}

config("native_rdb_config") {
  visibility = [ ":*" ]

  cflags = native_rdb_platform_cflags
  include_dirs = native_rdb_platform_include_dirs

  defines = native_rdb_platform_defines
}

config("native_rdb_public_config") {
  visibility = [ ":*" ]

  include_dirs = native_rdb_platform_public_include_dirs
}

if (native_rdb_platform_target_type == "ohos_shared_library") {
  ohos_shared_library("native_rdb") {
    branch_protector_ret = "pac_ret"
    if (defined(native_rdb_platform_sanitize)) {
      sanitize = native_rdb_platform_sanitize
    }

    part_name = native_rdb_common_part_name
    sources = base_sources + native_rdb_platform_sources

    configs = [ ":native_rdb_config" ]

    ldflags = native_rdb_platform_ldflags
    cflags_cc = native_rdb_platform_cflags_cc
    cflags_cc += [
      "-fvisibility=hidden",
      "-fvisibility-inlines-hidden",
      "-fno-unwind-tables",
      "-fno-asynchronous-unwind-tables",
      "-Os",
      "-Werror=vla",
    ]
    if (defined(native_rdb_platform_libs)) {
      libs = native_rdb_platform_libs
    }

    deps = native_rdb_platform_deps

    external_deps = native_rdb_platform_external_deps

    if (defined(native_rdb_platform_innerapi_tags)) {
      innerapi_tags = native_rdb_platform_innerapi_tags
    }

    public_configs = [ ":native_rdb_public_config" ]
    subsystem_name = native_rdb_common_subsystem_name
  }
} else if (native_rdb_platform_target_type == "ohos_source_set") {
  ohos_source_set("native_rdb") {
    part_name = native_rdb_common_part_name
    sources = base_sources + native_rdb_platform_sources

    configs = [ ":native_rdb_config" ]

    cflags_cc = native_rdb_platform_cflags_cc

    deps = native_rdb_platform_deps

    external_deps = native_rdb_platform_external_deps

    public_configs = [ ":native_rdb_public_config" ]
    subsystem_name = native_rdb_common_subsystem_name
  }
}

if (native_rdb_platform_has_extra_source_set) {
  ohos_source_set("native_rdb_src") {
    branch_protector_ret = "pac_ret"
    if (defined(native_rdb_platform_sanitize)) {
      sanitize = native_rdb_platform_sanitize
    }

    sources = base_sources + native_rdb_platform_sources

    configs = [ ":native_rdb_config" ]

    ldflags = native_rdb_platform_ldflags

    deps = native_rdb_platform_deps

    external_deps = native_rdb_platform_external_deps

    public_configs = [ ":native_rdb_public_config" ]

    subsystem_name = native_rdb_common_subsystem_name
    part_name = native_rdb_common_part_name
  }
}

if (native_rdb_platform_has_static_library) {
  ohos_static_library("native_rdb_static") {
    sources = base_sources + native_rdb_platform_sources

    configs = [ ":native_rdb_config" ]

    deps = native_rdb_platform_deps

    cflags_cc = native_rdb_platform_cflags_cc

    public_configs = [ ":native_rdb_public_config" ]

    subsystem_name = native_rdb_common_subsystem_name
    part_name = native_rdb_common_part_name
  }

  ohos_static_library("native_rdb_type_utils") {
    branch_protector_ret = "pac_ret"
    sanitize = {
      boundary_sanitize = true
      ubsan = true
      cfi = true
      cfi_cross_dso = true
      debug = false
    }

    sources = [ "${relational_store_native_path}/rdb/src/rdb_types_util.cpp" ]

    configs = [ ":native_rdb_config" ]

    external_deps = [
      "c_utils:utils",
      "hilog:libhilog",
      "ipc:ipc_core",
      "kv_store:datamgr_common",
    ]

    public_configs = [ ":native_rdb_public_config" ]

    subsystem_name = "distributeddatamgr"
    part_name = "relational_store"
  }
