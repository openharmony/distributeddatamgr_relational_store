import("//foundation/distributeddatamgr/relational_store/relational_store.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store_deps.gni")

native_rdb_platform_include_dirs = [
  "${relational_store_mock_path}/frameworks/native/rdb",
  "${relational_store_mock_path}/frameworks/native/win32",
  "${relational_store_common_path}/include",
  "//commonlibrary/c_utils/base/include",
  "include",
  "//foundation/communication/ipc/interfaces/innerkits/ipc_core/include",
  "${relational_store_native_path}/rdb_crypt",
  "${relational_store_native_path}/rdb/include",
  "${relational_store_native_path}/dfx/include",
  "${relational_store_native_path}/obs_mgr_adapter",
  "//third_party/libuv/src/win",
  "//foundation/distributeddatamgr/kv_store/frameworks/common",
  "//third_party/sqlite/include",
  "//third_party/json/single_include",
]

native_rdb_platform_cflags = [
  "-includemock.h",
  "-Werror=vla",
]

native_rdb_platform_cflags_cc = [
  "-std=c++17",
  "-Dlocaltime_r(a,b)=localtime_s(b,a)",
  "-Werror=vla",
]

native_rdb_platform_defines = [
  "RELATIONAL_STORE",
  "SQLITE_HAS_CODEC",
  "WINDOWS_PLATFORM",
  "CROSS_PLATFORM",
]

native_rdb_platform_ldflags = []

native_rdb_platform_libs = [ "//prebuilts/mingw-w64/ohos/linux-x86_64/clang-mingw/x86_64-w64-mingw32/lib/libws2_32.a" ]

native_rdb_platform_sources = [
  "${relational_store_mock_path}/frameworks/native/win32/directory_ex.cpp",
  "${relational_store_mock_path}/frameworks/native/win32/dlfcn.cpp",
  "${relational_store_mock_path}/frameworks/native/win32/openssl/hmac.cpp",
  "${relational_store_mock_path}/frameworks/native/rdb/mock.cpp",
  "${relational_store_mock_path}/frameworks/native/rdb/shared_block_mock.cpp",
]

native_rdb_platform_deps = [
  "${relational_store_innerapi_path}/appdatafwk:relational_common_base",
  "//commonlibrary/c_utils/base:utils",
  "//foundation/distributeddatamgr/kv_store/databaseutils:database_utils",
  "//foundation/distributeddatamgr/kv_store/interfaces/innerkits/distributeddata:distributeddata_inner_executor",
  "//third_party/sqlite:sqlite_sdk",
]
native_rdb_platform_deps += deps_hilog

native_rdb_platform_external_deps = []
native_rdb_platform_external_deps += external_deps_hilog

native_rdb_platform_public_include_dirs = [
  "include",
  "${relational_store_native_path}/rdb/include",
  "${relational_store_native_path}/dfx/include",
  "//third_party/libuv/src/win",
  "../cloud_data/include",
  "../common_type/include",
]

native_rdb_platform_innerapi_tags = [ "platformsdk" ]
native_rdb_platform_target_type = "ohos_shared_library"
native_rdb_platform_has_extra_source_set = false
native_rdb_platform_has_static_library = true
native_rdb_platform_add_mock_source = true