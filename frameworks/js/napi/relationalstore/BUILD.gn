import("//build/ohos.gni")
import("//build/ohos/ace/ace.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store.gni")
import(
    "//foundation/distributeddatamgr/relational_store/relational_store_deps.gni")
import("platform/common.gni")

if (is_ohos) {
  import("platform/ohos/config.gni")
} else if (is_mingw) {
  import("platform/mingw/config.gni")
} else if (is_mac) {
  import("platform/mac/config.gni")
} else if (is_android) {
  import("platform/android/config.gni")
} else if (is_ios) {
  import("platform/ios/config.gni")
} else if (is_linux) {
  import("platform/linux/config.gni")
}

ohos_copy("relational_store_declaration") {
  sources = [ "./api" ]
  outputs = [ target_out_dir + "/$target_name/" ]
  module_source_dir = target_out_dir + "/$target_name"
  module_install_name = ""
}

ohos_shared_library("relationalstore") {
  branch_protector_ret = "pac_ret"
  include_dirs = relationalstore_js_platform_include_dirs
  cflags_cc = relationalstore_js_platform_cflags_cc
  defines = relationalstore_js_platform_defines

  sources =
      relationalstore_js_common_sources + relationalstore_js_platform_sources

  external_deps = relationalstore_js_platform_external_deps
  external_deps += external_deps_api_metrics
  cflags_cc += [
    "-Os",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
  ]

  ldflags = [ "-Wl,--exclude-libs,ALL" ]
  deps = relationalstore_js_platform_deps
  defines += defines_api_metrics
  if (relational_store_data_share_enabled) {
    external_deps += [ "data_share:datashare_common_lite" ]
    deps += [ "${relational_store_innerapi_path}/rdb_data_share_adapter:rdb_data_share_adapter" ]
  }

  subsystem_name = relationalstore_js_common_subsystem_name
  part_name = relationalstore_js_common_part_name
  relative_install_dir = relationalstore_js_common_relative_install_dir
}

ohos_source_set("data_relationalstore") {
  include_dirs = relationalstore_js_platform_include_dirs
  cflags_cc = relationalstore_js_platform_cflags_cc
  defines = relationalstore_js_platform_defines

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  sources =
      relationalstore_js_common_sources + relationalstore_js_platform_sources

  deps = relationalstore_js_platform_deps

  external_deps = relationalstore_js_platform_external_deps

  subsystem_name = relationalstore_js_common_subsystem_name
  part_name = relationalstore_js_common_part_name
}

group("relationalstore_js") {
  deps = []
  if (relationalstore_js_platform_target_type == "ohos_shared_library") {
    deps += [ ":relationalstore" ]
  }
  if (relationalstore_js_platform_target_type == "ohos_source_set") {
    deps += [ ":data_relationalstore" ]
  }
}
