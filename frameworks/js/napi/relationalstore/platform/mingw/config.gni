import("//foundation/distributeddatamgr/relational_store/relational_store.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store_deps.gni")

relationalstore_js_platform_include_dirs = [
  "mock/include",
  "${relational_store_common_path}/include",
  "${relational_store_js_common_path}/mock/include",
  "${relational_store_napi_path}/relationalstore/mock/include",
  "//commonlibrary/c_utils/base/include",
  "include",
  "${relational_store_js_common_path}/include",
]

relationalstore_js_platform_cflags_cc = [
  "-std=c++17",
  "-stdlib=libc++",
  "-Werror=vla",
]

relationalstore_js_platform_defines = [
  "WINDOWS_PLATFORM",
  "CROSS_PLATFORM",
  "API_EXPORT=__declspec(dllimport)",
]

relationalstore_js_platform_sources = [
  "${relational_store_js_common_path}/mock/src/js_ability.cpp",
  "src/napi_rdb_histogram_reporter.cpp",
]

relationalstore_js_platform_deps = [
  "//foundation/arkui/napi:ace_napi",
  "${relational_store_innerapi_path}/rdb:native_rdb",
]
relationalstore_js_platform_deps += deps_hilog

relationalstore_js_platform_external_deps = [
  "bounds_checking_function:libsec_static",
  "kv_store:datamgr_common",
]
relationalstore_js_platform_external_deps += external_deps_hilog

relationalstore_js_platform_target_type = "ohos_shared_library"