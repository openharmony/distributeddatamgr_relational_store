import("//build/ohos.gni")
import("//build/ohos/ace/ace.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store_deps.gni")

ohos_copy("relational_store_declaration") {
  sources = [ "./api" ]
  outputs = [ target_out_dir + "/$target_name/" ]
  module_source_dir = target_out_dir + "/$target_name"
  module_install_name = ""
}

ohos_shared_library("napi_rdb") {
  branch_protector_ret = "pac_ret"
  sources = [
    "../common/src/js_df_manager.cpp",
    "../common/src/js_scope.cpp",
    "../common/src/js_utils.cpp",
    "../common/src/js_uv_queue.cpp",
    "src/napi_async_call.cpp",
    "src/napi_rdb_const_properties.cpp",
    "src/napi_rdb_js_utils.cpp",
    "src/napi_rdb_predicates.cpp",
    "src/napi_rdb_store.cpp",
    "src/napi_rdb_store_helper.cpp",
    "src/napi_result_set.cpp",
    "src/napi_values_bucket.cpp",
  ]

  if (is_mingw || is_mac) {
    include_dirs = [
      "mock/include",
      "${relational_store_common_path}/include",
      "${relational_store_js_common_path}/mock/include",
      "${relational_store_napi_path}/rdb/mock/include",
      "//commonlibrary/c_utils/base/include",
      "include",
      "${relational_store_js_common_path}/include",
    ]
    cflags_cc = [
      "-std=c++17",
      "-stdlib=libc++",
      "-Werror=vla",
    ]
    if (is_mac) {
      buildos = "mac"
      defines = [
        "MAC_PLATFORM",
        "CROSS_PLATFORM",
      ]
    } else {
      buildos = "windows"
      defines = [
        "WINDOWS_PLATFORM",
        "CROSS_PLATFORM",
      ]
    }
    sources += [ "${relational_store_js_common_path}/mock/src/js_ability.cpp" ]
    deps = [
      "//base/hiviewdfx/hilog/interfaces/native/innerkits:libhilog_${buildos}",
      "//foundation/arkui/napi:ace_napi",
      "//foundation/distributeddatamgr/relational_store/interfaces/inner_api/rdb:native_rdb",
    ]

    external_deps = [
      "bounds_checking_function:libsec_static",
    ]
    external_deps += external_deps_datamgr_common
  } else {
    include_dirs = [
      "include",
      "${relational_store_common_path}/include",
      "${relational_store_js_common_path}/include",
      "${relational_store_napi_path}/rdb/include",
    ]
    defines = [ "SQLITE_DISTRIBUTE_RELATIONAL" ]
    cflags_cc = [
      "-Oz",
      "-fno-unwind-tables",
      "-fno-asynchronous-unwind-tables",
    ]

    ldflags = [ "-Wl,--exclude-libs,ALL" ]
    version_script = "napi_rdb.versionscript"

    sources += [
      "${relational_store_js_common_path}/src/js_ability.cpp",
      "src/napi_rdb_store_observer.cpp",
    ]

    deps = [
      "${relational_store_innerapi_path}/appdatafwk:native_appdatafwk",
      "${relational_store_innerapi_path}/rdb:native_rdb",
    ]
    deps += deps_ability_runtime
    deps += deps_common_event_service
    deps += deps_eventhandler
    deps += deps_hilog
    deps += deps_hitrace
    deps += deps_ipc_single
    deps += deps_datamgr_common
    deps += deps_napi

    external_deps = [
      "c_utils:utils",
    ]
    external_deps += external_deps_ability_runtime
    external_deps += external_deps_bounds_checking_function
    external_deps += external_deps_common_event_service
    external_deps += external_deps_eventhandler
    external_deps += external_deps_hilog
    external_deps += external_deps_hitrace
    external_deps += external_deps_ipc_single
    external_deps += external_deps_datamgr_common
    external_deps += external_deps_napi
    if (relational_store_data_share_enabled) {
      sources += [ "src/napi_data_share_adapter.cpp" ]
      deps += [ "${relational_store_innerapi_path}/rdb_data_share_adapter:rdb_data_share_adapter" ]
      external_deps += [ "data_share:datashare_common_lite" ]
    }
  }

  subsystem_name = "distributeddatamgr"
  innerapi_tags = [ "platformsdk" ]
  part_name = "relational_store"
}

ohos_shared_library("rdb") {
  branch_protector_ret = "pac_ret"
  sources = [ "src/entry_point.cpp" ]

  if (is_mingw || is_mac) {
    include_dirs = [
      "mock/include",
      "${relational_store_common_path}/include",
      "${relational_store_js_common_path}/mock/include",
      "${relational_store_napi_path}/rdb/mock/include",
      "//commonlibrary/c_utils/base/include",
      "include",
      "${relational_store_js_common_path}/include",
    ]
    cflags_cc = [
      "-std=c++17",
      "-stdlib=libc++",
      "-Werror=vla",
    ]
    if (is_mac) {
      buildos = "mac"
      defines = [
        "MAC_PLATFORM",
        "CROSS_PLATFORM",
      ]
    } else {
      buildos = "windows"
      defines = [
        "WINDOWS_PLATFORM",
        "CROSS_PLATFORM",
      ]
    }

    deps = [
      ":napi_rdb",
      "//base/hiviewdfx/hilog/interfaces/native/innerkits:libhilog_${buildos}",
      "//foundation/arkui/napi:ace_napi",
      "//foundation/distributeddatamgr/relational_store/interfaces/inner_api/rdb:native_rdb",
    ]
  } else {
    include_dirs = [
      "include",
      "${relational_store_js_common_path}/include",
      "${relational_store_napi_path}/rdb/include",
    ]
    defines = [ "SQLITE_DISTRIBUTE_RELATIONAL" ]

    deps = [
      ":napi_rdb",
      "${relational_store_innerapi_path}/appdatafwk:native_appdatafwk",
      "${relational_store_innerapi_path}/rdb:native_rdb",
    ]
    deps += deps_ability_runtime
    deps += deps_eventhandler
    deps += deps_hilog
    deps += deps_hitrace
    deps += deps_napi

    external_deps = [
      "c_utils:utils",
      "node:node_header_notice",
    ]
    external_deps += external_deps_eventhandler
    external_deps += external_deps_hilog
    external_deps += external_deps_hitrace
    external_deps += external_deps_napi
    if (relational_store_data_share_enabled) {
      deps += [ "${relational_store_innerapi_path}/rdb_data_share_adapter:rdb_data_share_adapter" ]
      external_deps += [ "data_share:datashare_common_lite" ]
    }
  }

  subsystem_name = "distributeddatamgr"
  part_name = "relational_store"
  relative_install_dir = "module/data"
}
