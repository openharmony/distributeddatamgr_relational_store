import("//build/ohos.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store.gni")

group("js_kits") {
  deps = [
    "cloud_data:clouddata",
    "common:commontype_napi",
    "dataability:dataability",
    "rdb:rdb",
    "rdb:napi_rdb",
    "relationalstore:relationalstore_js",
    "sendablerelationalstore:sendablerelationalstore",
