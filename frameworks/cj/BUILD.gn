import("//build/ohos.gni")
import("//build/ohos/ace/ace.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store.gni")
import(
    "//foundation/distributeddatamgr/relational_store/relational_store_deps.gni")

ohos_shared_library("cj_relational_store_ffi") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    boundary_sanitize = true
    ubsan = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  include_dirs = [
    "include",
    "${relational_store_common_path}/include",
    "${relational_store_js_common_path}/include",
    "${relational_store_napi_path}/relationalstore/include",
  ]

  if (product_name != "ohos-sdk") {
    sources = [
      "src/relational_store_core_ffi.cpp",
      "src/relational_store_predicates_ffi.cpp",
      "src/relational_store_store_ffi.cpp",
      "src/relational_store_resultset_ffi.cpp",
      "src/relational_store_impl_rdbpredicatesproxy_core.cpp",
      "src/relational_store_impl_rdbpredicatesproxy_comparison.cpp",
      "src/relational_store_impl_rdbstore_observer.cpp",
      "src/relational_store_impl_rdbstore_core.cpp",
      "src/relational_store_impl_rdbstore_config.cpp",
      "src/relational_store_impl_resultsetproxy_core.cpp",
      "src/relational_store_impl_resultsetproxy_extended.cpp",
      "src/relational_store_impl_rdbstore_extensions.cpp",
      "src/relational_store_literesultset_ffi.cpp",
      "src/relational_store_transaction_ffi.cpp",
      "src/relational_store_impl_literesultset_core.cpp",
      "src/relational_store_impl_literesultset_extended.cpp",
      "src/relational_store_impl_transaction_core.cpp",
      "src/relational_store_impl_transaction_query.cpp",
      "src/relational_store_utils.cpp",
    ]

    deps = [
      "${relational_store_innerapi_path}/appdatafwk:native_appdatafwk",
      "${relational_store_innerapi_path}/rdb:native_rdb",
      "${relational_store_napi_path}/rdb:napi_rdb",
      "${relational_store_napi_path}/relationalstore",
    ]
    deps += deps_ability_runtime
    deps += deps_common_event_service
    deps += deps_hilog
    deps += deps_hitrace
    deps += deps_napi
    deps += deps_ipc_single
    deps += deps_cj_bind_ffi
    deps += deps_cj_bind_native
    deps += deps_eventhandler
    external_deps = [
      "bounds_checking_function:libsec_shared",
      "c_utils:utils",
      "json:nlohmann_json_static",
    ]
    external_deps += external_deps_cj_bind_ffi
    external_deps += external_deps_cj_bind_native
    external_deps += external_deps_ability_runtime
    external_deps += external_deps_common_event_service
    external_deps += external_deps_hilog
    external_deps += external_deps_hitrace
    external_deps += external_deps_napi
    external_deps += external_deps_ipc_single
    external_deps += external_deps_eventhandler
  } else {
    defines += [ "PREVIEWER" ]
    sources = [ "mock/relational_store_mock.cpp" ]
  }
  innerapi_tags = [ "platformsdk" ]
  subsystem_name = "distributeddatamgr"
  part_name = "relational_store"
}
