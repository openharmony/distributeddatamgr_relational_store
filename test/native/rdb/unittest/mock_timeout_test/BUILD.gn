import("//build/test.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store_deps.gni")

module_output_path = "relational_store/relational_store/native_rdb"

###############################################################################
config("module_private_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "${relational_store_common_path}/include",
    "${relational_store_native_path}/rdb/include",
    "${relational_store_native_path}/rd/include",
    "${relational_store_innerapi_path}/rdb/include",
    "${relational_store_native_path}/dfx/include",
    "${relational_store_native_path}/obs_mgr_adapter",
    "${relational_store_native_path}/rdb/src",
    "${relational_store_native_path}/rd/src",
    "${relational_store_innerapi_path}/appdatafwk/include",
    "${relational_store_native_path}/rdb_crypt",
    "${relational_store_native_path}/rdb_device_manager_adapter/include",
    "${relational_store_base_path}/test/native/rdb/unittest",
    "${relational_store_native_path}/rdb_service_adapter/include",
  ]

  defines = [ "RELATIONAL_STORE" ]
}

ohos_unittest("MockNativeRdbTest") {
  module_out_path = module_output_path

  cflags = [
    "-fno-access-control",
    "-Werror=vla",
  ]

  sources = base_sources
  sources -= [ "${relational_store_native_path}/rdb/src/sql_timeout_guard.cpp" ]
  sources += [
    "rdb_timeout_interrupt_test.cpp",
    "mock_sql_timeout_guard.cpp",
    "${relational_store_native_path}/appdatafwk/src/general_endian.cpp",
    "${relational_store_native_path}/appdatafwk/src/serializable.cpp",
    "${relational_store_native_path}/appdatafwk/src/shared_block.cpp",
    "${relational_store_native_path}/rdb/src/abs_shared_result_set.cpp",
    "${relational_store_native_path}/rdb/src/rdb_file_system.cpp",
    "${relational_store_native_path}/rdb/src/share_block.cpp",
    "${relational_store_native_path}/rdb/src/shared_block_serializer_info.cpp",
    "${relational_store_native_path}/rdb/src/sqlite_shared_result_set.cpp",
  ]

  if (is_ohos) {
    sources += [
      "${relational_store_native_path}/rdb_service_adapter/src/marshal_utils_impl.cpp",
      "${relational_store_native_path}/rdb_service_adapter/src/rdb_manager_impl.cpp",
      "${relational_store_native_path}/rdb_service_adapter/src/rdb_notifier_stub.cpp",
      "${relational_store_native_path}/rdb_service_adapter/src/rdb_service_proxy.cpp",
      "${relational_store_native_path}/rdb_service_adapter/src/rdb_types_util.cpp",
      "${relational_store_native_path}/rdb_service_adapter/src/result_set_proxy.cpp",
    ]
  }

  if (is_linux) {
    sources += [ "${relational_store_mock_path}/external_inner_kit/c_utils/ashmem.cpp" ]
  }

  configs = [ ":module_private_config" ]

  external_deps = [
    "c_utils:utils",
    "googletest:gtest_main",
    "json:nlohmann_json_static",
    "openssl:libcrypto_shared",
    "sqlite:sqlite",
  ]
  external_deps += external_deps_file_api
  external_deps += external_deps_hilog
  external_deps += external_deps_ability_base_zuri
  external_deps += external_deps_ability_runtime_dataobs_manager
  external_deps += external_deps_hisysevent
  external_deps += external_deps_ipc_core
  external_deps += external_deps_database_utils
  external_deps += external_deps_datamgr_common
  external_deps += external_deps_distributeddata_inner
  external_deps += external_deps_distributeddb
  external_deps += external_deps_distributeddb_client
  external_deps += external_deps_samgr
  external_deps += external_deps_bounds_checking_function

  deps = [ "${relational_store_innerapi_path}/rdb:native_rdb" ]
  deps += deps_ability_base_zuri
  deps += deps_ability_runtime_dataobs_manager
  deps += deps_file_api
  deps += deps_hilog
  deps += deps_hisysevent
  deps += deps_ipc_core
  deps += deps_database_utils
  deps += deps_datamgr_common
  deps += deps_distributeddata_inner
  deps += deps_distributeddb
  deps += deps_distributeddb_client
  deps += deps_samgr
}

###############################################################################
group("unittest") {
  testonly = true

  deps = [ ":MockNativeRdbTest" ]
}
###############################################################################
