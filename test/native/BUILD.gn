import("//build/test.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store.gni")
import(
    "//foundation/distributeddatamgr/relational_store/relational_store_deps.gni")

group("unittest") {
  testonly = true
  deps = [
    "appdatafwk:unittest",
    "clouddata:unittest",
    "dataability:unittest",
    "rdb:unittest",
    "rdb/unittest/dynamic_load_test:unittest",
    "rdb/unittest/mock_obs_manage_test:unittest",
    "rdb/unittest/sqlite_statement_test:unittest",
    "rdb/unittest/mockservice:unittest",
  ]
  if (relational_store_data_share_enabled) {
    deps += [
      "rdb_data_ability_adapter:unittest",
      "rdb_data_share_adapter:unittest",
    ]
  }
  if (relational_store_datamgr_service_enabled) {
    deps += [ "rdb_service_adapter:unittest" ]
  }
}

group("fuzztest") {
  testonly = true
  deps = []

  deps += [ "clouddata:fuzztest" ]
  deps += [ "rdb:fuzztest" ]
}

group("distributedtest") {
  testonly = true
  deps = []

  deps += [ "rdb:distributedtest" ]
}

group("all_tests") {
  testonly = true
  deps = [
    ":distributedtest",
    ":fuzztest",
    ":unittest",
  ]
}
