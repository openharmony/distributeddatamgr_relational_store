import("//build/test.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store.gni")
import("//foundation/distributeddatamgr/relational_store/relational_store_deps.gni")

module_output_path = "relational_store/relational_store/native_rdb_ndk"

###############################################################################
config("module_private_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "${relational_store_base_path}/interfaces/ndk",
    "${relational_store_base_path}/interfaces/ndk/include",
    "${relational_store_innerapi_path}/rdb/include",
    "${relational_store_innerapi_path}/appdatafwk/include",
    "${relational_store_base_path}/interfaces/ndk/src",
    "${relational_store_common_path}/include",
    "${relational_store_native_path}/rdb/include",
    "${relational_store_native_path}/rd/include",
  ]
}

ohos_unittest("NativeRdbNdkTest") {
  module_out_path = module_output_path

  cflags = [
    "-fno-access-control",  # Ignore Private Member Access Control
    "-Werror=vla",
  ]

  sources = [
    "unittest/rdb_asset_test.cpp",
    "unittest/rdb_crypto_param_test.cpp",
    "unittest/rdb_cursor_test.cpp",
    "unittest/rdb_cursor_getSize_test.cpp",
    "unittest/rdb_performance_test.cpp",
    "unittest/rdb_predicates_pref_test.cpp",
    "unittest/rdb_predicates_test.cpp",
    "unittest/rdb_query_without_rowCount_test.cpp",
    "unittest/rdb_store_configv2_test.cpp",
    "unittest/rdb_store_corrupt_handler_test.cpp",
    "unittest/rdb_store_rekeyEx_test.cpp",
    "unittest/rdb_store_returning_test.cpp",
    "unittest/rdb_store_test.cpp",
    "unittest/rdb_transaction_capi_test.cpp",
    "unittest/rdb_transaction_query_without_rowCount_test.cpp",
    "unittest/rdb_vector_test.cpp",
    "unittest/relational_cursor_test.cpp",
  ]

  configs = [ ":module_private_config" ]

  external_deps = [
    "c_utils:utils",
    "googletest:gtest_main",
    "json:nlohmann_json_static",
  ]
  external_deps += external_deps_hilog
  external_deps += external_deps_datamgr_common
  external_deps += external_deps_access_token_libaccesstoken_sdk
  external_deps += external_deps_access_token_libtoken_setproc
  external_deps += external_deps_access_token_libtokenid_sdk

  deps = [
    "${relational_store_base_path}/interfaces/ndk:native_rdb_ndk",
    "${relational_store_base_path}/interfaces/rdb_ndk_utils:native_rdb_ndk_utils",
    "${relational_store_innerapi_path}/rdb:native_rdb",
  ]
  deps += deps_hilog
  deps += deps_datamgr_common
  deps += deps_access_token_libaccesstoken_sdk
  deps += deps_access_token_libtoken_setproc
  deps += deps_access_token_libtokenid_sdk
}

###############################################################################
group("unittest") {
  testonly = true

  deps = [ ":NativeRdbNdkTest" ]
}

group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    "fuzztest/dataasset_fuzzer:fuzztest",
    "fuzztest/datavalue_fuzzer:fuzztest",
    "fuzztest/ohcursor_fuzzer:fuzztest",
    "fuzztest/ohdatavalue_fuzzer:fuzztest",
    "fuzztest/ohdatavaluesbuckets_fuzzer:fuzztest",
    "fuzztest/ohdatavalues_fuzzer:fuzztest",
    "fuzztest/ohpredicates_fuzzer:fuzztest",
    "fuzztest/ohrdbcryptoparam_fuzzer:fuzztest",
    "fuzztest/ohrdbtransaction_fuzzer:fuzztest",
    "fuzztest/relationalstore_fuzzer:fuzztest",
    "fuzztest/relationalstorecapi_fuzzer:fuzztest",
    "fuzztest/valuebucket_fuzzer:fuzztest",
    "fuzztest/ohvalueobject_fuzzer:fuzztest",
  ]
}
