import("//foundation/distributeddatamgr/relational_store/relational_store.gni")

relational_store_mock_external_kit_path =
    "${relational_store_mock_path}/external_inner_kit"

declare_args() {
  if (defined(global_parts_info) &&
      defined(global_parts_info.ability_ability_base)) {
    relational_store_ability_base_enabled = true
  } else {
    relational_store_ability_base_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.ability_ability_runtime)) {
    relational_store_ability_runtime_enabled = true
  } else {
    relational_store_ability_runtime_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.hiviewdfx_hilog)) {
    relational_store_hilog_enabled = true
  } else {
    relational_store_hilog_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.hiviewdfx_hitrace)) {
    relational_store_hitrace_enabled = true
  } else {
    relational_store_hitrace_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.hiviewdfx_hisysevent)) {
    relational_store_hisysevent_enabled = true
  } else {
    relational_store_hisysevent_enabled = false
  }

  if (defined(global_parts_info) && defined(global_parts_info.arkui_napi)) {
    relational_store_napi_enabled = true
  } else {
    relational_store_napi_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.filemanagement_file_api)) {
    relational_store_file_api_enabled = true
  } else {
    relational_store_file_api_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.arkcompiler_runtime_core)) {
    relational_store_ani_helpers_enabled = true
  } else {
    relational_store_ani_helpers_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.notification_eventhandler)) {
    relational_store_eventhandler_enabled = true
  } else {
    relational_store_eventhandler_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.communication_ipc)) {
    relational_store_ipc_enabled = true
  } else {
    relational_store_ipc_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.systemabilitymgr_samgr)) {
    relational_store_samgr_enabled = true
  } else {
    relational_store_samgr_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.security_huks)) {
    relational_store_huks_enabled = true
  } else {
    relational_store_huks_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.security_access_token)) {
    relational_store_access_token_enabled = true
  } else {
    relational_store_access_token_enabled = false
  }

  if (!defined(global_parts_info) ||
      defined(global_parts_info.distributeddatamgr_data_share)) {
    relational_store_data_share_enabled = true
  } else {
    relational_store_data_share_enabled = false
  }

  if (!defined(global_parts_info) ||
      defined(global_parts_info.distributeddatamgr_datamgr_service)) {
    relational_store_datamgr_service_enabled = true
  } else {
    relational_store_datamgr_service_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.notification_common_event_service)) {
    relational_store_common_event_service_enabled = true
  } else {
    relational_store_common_event_service_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.systemabilitymgr_safwk)) {
    relational_store_safwk_enabled = true
  } else {
    relational_store_safwk_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.bundlemanager_bundle_framework)) {
    relational_store_bundle_framework_enabled = true
  } else {
    relational_store_bundle_framework_enabled = false
  }

  relational_store_api_metrics_enabled = true
  if (defined(global_parts_info) &&
      !defined(global_parts_info.hiviewdfx_api_metrics)) {
    relational_store_api_metrics_enabled = false
  }
}

